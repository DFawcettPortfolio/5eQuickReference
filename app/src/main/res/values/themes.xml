<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- App theme (forces black status bar after splash) -->
    <style name="Theme.WildShapesMountsAndFamiliars" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">#000000</item> <!-- Black top bar -->
        <item name="android:windowLightStatusBar">false</item> <!-- Light icons -->
        <item name="android:windowBackground">#000000</item> <!-- No white flash -->
    </style>

    <!-- Splash screen theme -->
    <style name="Theme.WildShapes.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#000000</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.WildShapesMountsAndFamiliars</item>
    </style>

</resources>
